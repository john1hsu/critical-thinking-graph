<https://github.com/john1hsu/critical-thinking-graph/id/selection-bias#graph> {
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://purl.org/dc/terms/created> "2026-11-11"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/critical-thinking-graph/ontology#Phenomenon> .
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://www.w3.org/2000/01/rdf-schema#label> "Selection bias" .
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://www.w3.org/2004/02/skos/core#altLabel> "sample selection bias" .
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://www.w3.org/2004/02/skos/core#altLabel> "selection effect" .
  <https://github.com/john1hsu/critical-thinking-graph/id/selection-bias> <http://www.w3.org/2004/02/skos/core#broader> <https://github.com/john1hsu/critical-thinking-graph/id/causal-inference> .
