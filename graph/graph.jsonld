   ],
   "rdfs:label": "Validity",
   "skos:altLabel": [
    "deductive validity",
    "logical validity",
    "valid argument"
   ],
   "skos:broader": {
    "@id": "ct:deductive-reasoning"
   },
   "skos:definition": "The property of a deductive argument whose form makes it impossible for all the premises to be true and the conclusion false; validity concerns the link between premises and conclusion, not whether the premises are actually true.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/foundations"
   },
   "skos:prefLabel": "Validity",
