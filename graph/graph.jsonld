  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/undistributed-middle/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:undistributed-middle"
   },
   "rdfs:label": "Is the shared term ever used to speak about every member of its class, in either premise?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/undistributed-middle/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:undistributed-middle"
   },
   "rdfs:label": "Could the two groups in the conclusion each overlap a different part of the shared class?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/undistributed-middle/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:undistributed-middle"
   },
   "rdfs:label": "Would I still accept this form if the conclusion were something I believed to be false?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/undistributed-middle/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:undistributed-middle"
   },
   "cto:verdict": "invalid"
  },
  {
