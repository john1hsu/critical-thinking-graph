  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "With about 5,000 cards on the system, roughly five would match by chance, so without other evidence the match alone points to one of about six cardholders."
  },
  {
