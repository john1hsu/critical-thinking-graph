   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/ra",
   "@type": "aif:RA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/c"
