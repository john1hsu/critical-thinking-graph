   "rdfs:label": "Modal scope fallacy",
   "skos:altLabel": [
    "confusing necessity of the consequence with necessity of the consequent",
    "fallacy of necessity",
    "the modal fallacy"
   ],
   "skos:broader": {
    "@id": "ct:formal-fallacy"
   },
   "skos:definition": "The invalid inference from \"necessarily, if P then Q\" and \"P\" to \"necessarily Q\", which moves a necessity operator from the whole conditional onto its consequent and so turns a conditional, relative necessity into an absolute one.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/formal-fallacies"
   },
