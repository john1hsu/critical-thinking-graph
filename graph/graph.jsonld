   },
   "aif:Premise": [
    {
     "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/p1"
    },
    {
     "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/p2"
    }
   ],
   "aif:partOf": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:suppressed-evidence"
   },
   "rdfs:label": "What evidence on this question exists that the arguer has not mentioned, and would it point the other way?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:suppressed-evidence"
   },
   "rdfs:label": "How were the cited cases, studies or figures chosen, and could the selection itself explain the result?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:suppressed-evidence"
   },
   "rdfs:label": "Does the arguer have a stake that gives them a reason to leave out unfavourable facts?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:suppressed-evidence"
   },
   "rdfs:label": "If the full record were laid out, including the misses, would the conclusion still look as strong?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:suppressed-evidence"
   },
   "rdfs:label": "Is the omitted material actually relevant and significant, or just detail that does not bear on the conclusion?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:suppressed-evidence"
   },
   "cto:verdict": "fallacious"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/map/c",
