  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:tu-quoque"
   },
   "rdfs:label": "Does the speaker's conduct actually bear on whether the claim is true, or only on the speaker's character?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:tu-quoque"
   },
   "rdfs:label": "Are the speaker's situation and the situation the advice addresses really alike, or is the \"inconsistency\" a false double standard?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:tu-quoque"
   },
   "rdfs:label": "Is the lapse a settled habit, or a one-off failure, a past choice, or a matter of weak will that the speaker admits?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:tu-quoque"
   },
   "rdfs:label": "Is the claim resting on the speaker's own authority, or is it supported by independent evidence that the charge leaves untouched?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:tu-quoque"
   },
   "rdfs:label": "Does the speaker's failure to follow the advice suggest the advice is impractical, and if so, is that the point being made?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:tu-quoque"
   },
   "cto:verdict": "fallacious"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/c",
   "@type": "aif:I-node",
   "aif:claimText": "So the Friday logging rule is pointless and the team can ignore it."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/ca1",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/o1"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "Whether timely logging keeps invoices accurate does not depend on the team lead's own habits."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/o2",
   "@type": "aif:I-node",
   "aif:claimText": "Her lateness may justify asking her to explain herself or to follow the rule too, not dropping the rule."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/p1",
   "@type": "aif:I-node",
   "aif:claimText": "A team lead asks everyone to log project hours by Friday so client invoices are accurate."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "The team lead often logs her own hours late."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/ra",
   "@type": "aif:RA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/c"
   },
   "aif:Premise": [
    {
     "@id": "https://github.com/john1hsu/critical-thinking-graph/id/tu-quoque/map/p1"
