   "rdfs:label": "William Whewell",
   "skos:altLabel": [
    "Rev. William Whewell",
    "Whewell"
   ],
   "skos:definition": "English philosopher, historian of science and Master of Trinity College, Cambridge (1794-1866), who built a theory of scientific induction from the history of the sciences, proposed prediction of new phenomena and the \"consilience of inductions\" as tests of a theory, debated John Stuart Mill on induction, and coined the word \"scientist\".",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/history-and-thinkers"
   },
