  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "No evidence is offered that each step makes the next one likely; requests for Fridays at home do not force management to grant Mondays."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/o2",
   "@type": "aif:I-node",
   "aif:claimText": "Management keeps control at every step: a written policy capping remote days is a bright line that stops the slide."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/o3",
   "@type": "aif:I-node",
   "aif:claimText": "The feared end state is assumed to be catastrophic without asking how other firms with hybrid schedules have fared."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/p1",
   "@type": "aif:I-node",
   "aif:claimText": "If we let the design team work from home on Fridays, the other teams will ask for the same."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "Once every team has Fridays at home, people will start asking for Mondays too, and soon nobody will come in at all."
  },
