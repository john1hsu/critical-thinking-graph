   "skos:altLabel": [
    "Aristotle's Rhetoric",
    "Ars Rhetorica",
    "On Rhetoric",
    "Techne Rhetorike"
   ],
   "skos:definition": "Aristotle's three-book treatise (4th century BCE) defining rhetoric as the ability to see the available means of persuasion in a case. It names three kinds of proof (the speaker's character, the audience's emotions and the argument itself) and treats argument through two rhetorical counterparts of logic: the enthymeme for deduction and the example (paradeigma) for induction, the first systematic account of arguing from one similar case to another.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/history-and-thinkers"
   },
   "skos:prefLabel": "Rhetoric (Aristotle)",
