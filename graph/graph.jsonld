   "rdfs:label": "Venn diagram test",
   "skos:altLabel": [
    "Venn diagram method",
    "Venn validity test",
    "three-circle test for syllogisms"
   ],
   "skos:broader": [
    {
     "@id": "ct:categorical-syllogism"
    },
    {
     "@id": "ct:diagrammatic-reasoning"
    }
   ],
   "skos:definition": "A visual decision procedure for categorical syllogisms: draw three overlapping circles for the three terms, record only what the premises say (shading for empty regions, an X for \"at least one\"), and the argument is valid exactly when the conclusion can be read off the finished diagram.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/formal-logic"
   },
   "skos:prefLabel": "Venn diagram test",
