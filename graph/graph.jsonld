   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "The past job is a fair reason to check the cost comparison closely, not a reason to think its figures are false."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map/o2",
   "@type": "aif:I-node",
   "aif:claimText": "The comparison's numbers can be verified independently of who compiled them."
