   "rdfs:label": "Tu quoque",
   "skos:altLabel": [
    "appeal to hypocrisy",
    "tu quoque ad hominem",
    "you do it too",
    "you-too fallacy"
   ],
   "skos:broader": [
    {
     "@id": "ct:ad-hominem"
    },
    {
     "@id": "ct:informal-fallacy"
    }
   ],
   "skos:definition": "The fallacy of rejecting a claim, advice or criticism on the grounds that the person making it does not act in line with it, as if the speaker's inconsistency showed the claim itself to be false.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/informal-fallacies"
   },
