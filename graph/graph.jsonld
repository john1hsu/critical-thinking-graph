  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/amphiboly/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:amphiboly"
   },
   "rdfs:label": "Which sentence in the argument can be parsed in more than one way, and what are the readings?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/amphiboly/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:amphiboly"
   },
   "rdfs:label": "On the reading that makes the premise true or authoritative, does the conclusion still follow?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/amphiboly/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:amphiboly"
   },
   "rdfs:label": "Is there evidence from context, the author's purpose or how the text has been applied before that settles which reading was intended?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/amphiboly/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:amphiboly"
   },
   "rdfs:label": "Could the sentence be rewritten so that only one structure is possible, and does the argument survive the rewrite?"
  },
