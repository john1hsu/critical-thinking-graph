  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/c",
   "@type": "aif:I-node",
   "aif:claimText": "The vendor library presumably contains a critical vulnerability, so we should not ship it yet."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/ca1",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/o1"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "If other security specialists who reviewed the library disagree, or the claim rests on an outdated version of the code, the presumption weakens and must be re-examined."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/p1",
   "@type": "aif:I-node",
   "aif:claimText": "Our security lead says the new vendor library contains a critical vulnerability."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "Our security lead is an expert in application security."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argumentation-schemes/map/ra",
