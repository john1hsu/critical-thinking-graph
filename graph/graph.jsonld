  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Would the other side recognise this description as their own position, stated in their own terms?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Is the view being refuted what was actually said, or an exaggerated, absolute or invented version of it?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "If the weakest argument has been answered, have the stronger arguments for the same conclusion been addressed too?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Who exactly holds the position being attacked, or is it attributed only to a vague \"some people\"?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Does refuting this version leave the original claim standing?"
  },
