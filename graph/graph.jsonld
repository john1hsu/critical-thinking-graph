   "rdfs:label": "Abraham de Moivre",
   "skos:altLabel": [
    "Abraham De Moivre",
    "Abraham Demoivre",
    "De Moivre"
   ],
   "skos:definition": "French-born Huguenot mathematician (1667-1754) who worked in London and whose Doctrine of Chances (1718; 2nd ed. 1738; 3rd ed. 1756) gave the first textbook theory of probability, stating the rules for independent and dependent events that underlie conditional probability, and who first formulated the normal approximation to the binomial in 1733.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/history-and-thinkers"
   },
