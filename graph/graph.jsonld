  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-analogy"
   },
   "rdfs:label": "Are there differences between the two cases that would undermine the similarity being relied on?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-analogy"
   },
   "rdfs:label": "Are the shared features actually relevant to the conclusion, or only superficial?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-analogy"
   },
   "rdfs:label": "Is the conclusion really correct for the source case in the first place?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-analogy"
   },
   "rdfs:label": "Is there another similar case where a different conclusion was reached?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-analogy"
   },
   "rdfs:label": "Is the conclusion modest enough for the strength of the comparison?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-analogy/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
