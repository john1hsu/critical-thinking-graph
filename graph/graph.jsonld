   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/o1"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "Did she see the actual beam, or only the original drawings, which may not match what was built?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map/o2",
   "@type": "aif:I-node",
