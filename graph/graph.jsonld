   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:conjunction-fallacy"
   },
   "rdfs:label": "Is the detailed version of the claim really more likely than the shorter claim it contains?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/conjunction-fallacy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:conjunction-fallacy"
   },
   "rdfs:label": "If I strip out the extra detail, does every case that fits the detailed story still fit the short one?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/conjunction-fallacy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:conjunction-fallacy"
   },
   "rdfs:label": "Out of 100 comparable cases, how many would show A, and how many of those would also show B?"
