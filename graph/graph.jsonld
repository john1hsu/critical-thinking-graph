  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-ignorance/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-ignorance"
   },
   "rdfs:label": "How thoroughly has anyone actually looked for evidence on this question?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-ignorance/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-ignorance"
   },
   "rdfs:label": "If the claim were true, how likely is it that the search would have turned up evidence of it?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-ignorance/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-ignorance"
   },
   "rdfs:label": "Who carries the burden of proof here, and is the arguer quietly shifting it to the other side?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-ignorance/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
