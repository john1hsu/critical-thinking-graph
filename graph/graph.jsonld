   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/suppressed-evidence/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "The stated premises are true, but the omitted inspection failures bear directly on whether switching is wise."
  },
  {
