  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-consequences"
   },
   "rdfs:label": "How likely is it that the cited consequences will actually follow if the action is taken?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-consequences"
   },
   "rdfs:label": "What evidence supports the claim that those consequences will occur?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-consequences"
   },
   "rdfs:label": "Are there consequences of the opposite value, such as benefits of acting or costs of not acting, that should also be weighed?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-consequences"
   },
   "rdfs:label": "Is the question really a decision about what to do, or a question of fact on which good or bad consequences have no bearing?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-consequences"
   },
   "rdfs:label": "Is the speaker the one who would bring about the bad outcome, turning a warning into a threat?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:argument-from-consequences"
   },
   "cto:verdict": "strong"
  },
