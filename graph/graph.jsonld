  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Would the other side recognise this description as their own position, stated in their own terms?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Is the view being refuted what was actually said, or an exaggerated, absolute or invented version of it?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "If the weakest argument has been answered, have the stronger arguments for the same conclusion been addressed too?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Who exactly holds the position being attacked, or is it attributed only to a vague \"some people\"?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:straw-man-fallacy"
   },
   "rdfs:label": "Does refuting this version leave the original claim standing?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:straw-man-fallacy"
   },
   "cto:verdict": "fallacious"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/c",
   "@type": "aif:I-node",
   "aif:claimText": "So the work-from-home proposal should be rejected."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/ca1",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/o1"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "The proposal covers one day a week, not abolishing the office; the refuted position is not the one put forward."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/o2",
   "@type": "aif:I-node",
   "aif:claimText": "Even if full remote work harmed collaboration, that says little about the effect of one remote day."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/p1",
   "@type": "aif:I-node",
   "aif:claimText": "A colleague proposes letting staff work from home on Fridays to cut commuting time."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "Running the company with nobody ever in the office would destroy collaboration and training."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/straw-man-fallacy/map/ra",
   "@type": "aif:RA-node",
   "aif:Conclusion": {
