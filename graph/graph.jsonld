   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/post-hoc-ergo-propter-hoc/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:post-hoc-ergo-propter-hoc"
   },
