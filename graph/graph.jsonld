   "rdfs:label": "Judgment and decision making",
   "skos:altLabel": [
    "JDM",
    "behavioral decision research",
    "behavioral decision theory",
    "judgment and decision research"
   ],
   "skos:broader": {
    "@id": "ct:cognitive-psychology"
   },
   "skos:definition": "The interdisciplinary research field, rooted in psychology, that studies how people form judgments (estimates, predictions, probabilities) and make choices, typically by comparing actual behavior with normative standards such as probability theory and expected utility and then designing ways to close the gap.",
