   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "How credible is this person as an expert, judged by training, track record and standing in the field?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "Is the claim actually inside the person's field of expertise, or only next to it?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "What exactly did the expert say, and does it really imply the claim being made in their name?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "Is the expert personally reliable here, or do conflicts of interest or a history of bias give reason for doubt?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "Do other qualified experts in the field agree, or is this a minority or disputed view?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/cq/6",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:argument-from-expert-opinion"
   },
   "rdfs:label": "Is the expert's statement based on evidence that could be produced and checked if asked?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-expert-opinion/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
