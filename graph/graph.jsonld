   "cto:questionFor": {
    "@id": "ct:post-hoc-ergo-propter-hoc"
   },
   "rdfs:label": "Apart from the order of events, what independent evidence links the earlier event to the later one?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/post-hoc-ergo-propter-hoc/cq/2",
