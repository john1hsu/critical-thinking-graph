   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map/ra"
