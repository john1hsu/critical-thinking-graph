   "rdfs:label": "De re/de dicto distinction",
   "skos:altLabel": [
    "de re and de dicto readings",
    "relational/notional distinction",
    "wide-scope/narrow-scope reading of attitude reports"
   ],
   "skos:broader": {
    "@id": "ct:predicate-logic"
   },
   "skos:definition": "The practice of separating two readings of a belief, knowledge or modal claim: de dicto, about how the subject thinks of or describes something (the term stays inside the \"that\"-clause), and de re, about the thing itself however it is described (the term takes wide scope). Fixing the reading shows when swapping co-referring terms is licensed.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/formal-logic"
   },
