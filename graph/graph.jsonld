   "cto:questionFor": {
    "@id": "ct:post-hoc-ergo-propter-hoc"
   },
   "rdfs:label": "Would the later event probably have happened anyway, for example through seasonal patterns, spontaneous recovery or a return from an unusual extreme?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/post-hoc-ergo-propter-hoc/cq/3",
   "@type": "cto:CriticalQuestion",
