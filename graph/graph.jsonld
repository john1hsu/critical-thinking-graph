  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-the-consequent"
   },
   "rdfs:label": "Besides the stated antecedent, what else could make the consequent true?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-the-consequent"
   },
   "rdfs:label": "Does the conditional really run both ways, or has a one-way \"if\" been heard as \"if and only if\"?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-the-consequent"
   },
   "rdfs:label": "How often does the consequent occur when the antecedent is false, and has that rate been checked?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-the-consequent"
   },
   "rdfs:label": "Have rival explanations of the observed consequent been compared before accepting the antecedent?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/map",
