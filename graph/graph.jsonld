  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:slippery-slope"
   },
   "rdfs:label": "What are the intermediate steps between the first move and the feared outcome, and is each one supported by evidence rather than just asserted?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:slippery-slope"
   },
   "rdfs:label": "Why would we lose the ability to stop partway, and could a clear rule or bright line be drawn to halt the slide?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:slippery-slope"
   },
   "rdfs:label": "How likely is the final outcome, and is it really as bad as claimed?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:slippery-slope"
   },
   "rdfs:label": "Is the argument just a warning about bad consequences dressed up as an unstoppable chain?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
