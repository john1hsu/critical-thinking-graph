  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/quantifier-shift-fallacy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:quantifier-shift-fallacy"
   },
   "rdfs:label": "Does the premise allow a different B for each A, or does it really say one B serves them all?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/quantifier-shift-fallacy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:quantifier-shift-fallacy"
   },
   "rdfs:label": "Can you describe a case where every A has its own B but no single B works for every A?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/quantifier-shift-fallacy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:quantifier-shift-fallacy"
   },
   "rdfs:label": "If the conclusion needs one B for all, what separate evidence shows that such a B exists?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/quantifier-shift-fallacy/map",
