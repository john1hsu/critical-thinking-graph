   ],
   "skos:broader": {
    "@id": "ct:cognitive-bias"
   },
   "skos:definition": "The tendency for confidence in one's judgments, performance or estimates to exceed their actual accuracy, studied in three forms: overestimation of one's own performance, overplacement relative to others, and overprecision (excessive certainty that one's beliefs are correct).",
