  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:ad-hominem"
   },
   "rdfs:label": "How well is the allegation about the person actually supported by evidence?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:ad-hominem"
   },
   "rdfs:label": "Does the person's character, interest or conduct matter in this kind of exchange, for example because we are relying on their testimony or judgment?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:ad-hominem"
   },
   "rdfs:label": "Would the argument still stand if someone with no stake in it had made it?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:ad-hominem"
   },
   "rdfs:label": "Is the attack used to lower the weight we give the speaker's say-so, or to declare the claim itself false?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:ad-hominem"
   },
   "rdfs:label": "Could the apparent bias or inconsistency be explained once the person is allowed to respond?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/ad-hominem/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
