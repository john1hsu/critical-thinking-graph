   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/ca3",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/slippery-slope/map/ra"
