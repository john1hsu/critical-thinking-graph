   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:base-rate-neglect"
   },
   "rdfs:label": "Before looking at this evidence, how common is the outcome in the relevant population?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/base-rate-neglect/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:base-rate-neglect"
   },
   "rdfs:label": "How often would this same evidence show up if the outcome were absent (the false-positive rate)?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/base-rate-neglect/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:base-rate-neglect"
   },
   "rdfs:label": "Out of 1,000 comparable cases, how many would show the evidence and actually have the outcome?"
