   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/ca2",
   "@type": "aif:CA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/o2"
   }
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/o1",
   "@type": "aif:I-node",
   "aif:claimText": "A tested rollback plan makes a three-day outage unlikely, so the bad consequence is less probable than claimed."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/o2",
   "@type": "aif:I-node",
   "aif:claimText": "Waiting also has a cost: the old system's support contract lapses at month end."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/p1",
   "@type": "aif:I-node",
   "aif:claimText": "If we cut over to the new billing system on the holiday weekend and the cutover fails, customers may be unable to pay for up to three days."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "Three days of failed payments would cost us more than waiting two weeks would."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/ra",
   "@type": "aif:RA-node",
   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/argument-from-consequences/map/c"
