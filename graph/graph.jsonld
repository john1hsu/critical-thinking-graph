  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:prosecutors-fallacy"
   },
   "rdfs:label": "Is the figure being quoted the chance of the evidence if the person is innocent, or the chance the person is innocent given the evidence?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:prosecutors-fallacy"
   },
   "rdfs:label": "Before this evidence, how many people could plausibly have been responsible?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:prosecutors-fallacy"
   },
   "rdfs:label": "Out of everyone who could have produced this evidence by coincidence, how many would we expect to find?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:prosecutors-fallacy"
   },
   "rdfs:label": "How much more likely is the evidence if the person is responsible than if they are not?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:prosecutors-fallacy"
   },
   "rdfs:label": "Does the rest of the case make guilt likely or unlikely before this evidence is added?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:prosecutors-fallacy"
   },
   "cto:verdict": "fallacious"
  },
