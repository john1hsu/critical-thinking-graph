   ],
   "rdfs:label": "Necessary and sufficient conditions",
   "skos:altLabel": [
    "jointly sufficient conditions",
    "necessary condition",
    "necessity and sufficiency",
    "sufficient condition"
   ],
   "skos:broader": {
    "@id": "ct:conditional-statement"
   },
   "skos:definition": "A necessary condition for Y is one without which Y cannot hold; a sufficient condition for Y is one whose presence guarantees Y. In a true conditional \"if P then Q\", P is sufficient for Q and Q is necessary for P.",
   "skos:inScheme": {
