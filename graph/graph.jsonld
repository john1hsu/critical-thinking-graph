  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/p2",
   "@type": "aif:I-node",
   "aif:claimText": "Only 1 in 1,000 cards in the building system would share that partial ID by chance."
