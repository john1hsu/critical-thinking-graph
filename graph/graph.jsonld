  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:no-true-scotsman"
   },
   "rdfs:label": "Was the restriction (\"true\", \"real\", \"genuine\") part of the claim before the counterexample appeared, or was it added only after?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:no-true-scotsman"
   },
   "rdfs:label": "Is there an independent, agreed criterion for membership in the group, or is membership now defined by having the property in question?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:no-true-scotsman"
   },
   "rdfs:label": "Could any possible case count against the revised claim, or has it become true by definition?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:no-true-scotsman"
   },
   "rdfs:label": "If the narrowed claim is now safe, what does it still tell us about the actual members of the group?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/cq/5",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:no-true-scotsman"
   },
   "rdfs:label": "Is the dispute really about how the term should be defined, and if so, has that been argued for openly?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/no-true-scotsman/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
