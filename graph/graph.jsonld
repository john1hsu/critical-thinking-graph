   "aif:Conclusion": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/map/ra"
   },
   "aif:Premise": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-the-consequent/map/o2"
