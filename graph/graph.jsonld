  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-a-disjunct/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-a-disjunct"
   },
   "rdfs:label": "Could both alternatives in the \"or\" premise be true at the same time?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-a-disjunct/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-a-disjunct"
   },
   "rdfs:label": "Is the \"or\" meant exclusively, and if so, has the \"not both\" claim been stated and supported?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-a-disjunct/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-a-disjunct"
   },
   "rdfs:label": "Does the affirmed alternative by itself rule out the other one, independent of the disjunction?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-a-disjunct/cq/4",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:affirming-a-disjunct"
   },
   "rdfs:label": "What would a realistic case look like in which both options hold together?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/affirming-a-disjunct/map",
   "@type": "aif:ArgumentNetwork",
   "cto:illustrates": {
    "@id": "ct:affirming-a-disjunct"
   },
   "cto:verdict": "invalid"
  },
