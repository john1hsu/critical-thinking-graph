   "rdfs:label": "Gettier problem",
   "skos:altLabel": [
    "Gettier cases",
    "Gettier counterexamples",
    "problem of epistemic luck in the analysis of knowledge"
   ],
   "skos:broader": {
    "@id": "ct:epistemology"
   },
   "skos:definition": "The problem, raised by Edmund Gettier in 1963, that a person can hold a justified, true belief that still falls short of knowledge because it is true only by luck; it shows that justified true belief is not sufficient for knowing.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/philosophy-of-reasoning"
   },
   "skos:prefLabel": "Gettier problem",
   "skos:related": [
    {
     "@id": "ct:deductive-reasoning"
