   "rdfs:label": "Argument from consequences",
   "skos:altLabel": [
    "argument from negative consequences",
    "argument from positive consequences",
    "consequentialist argument",
    "pragmatic argument"
   ],
   "skos:broader": {
    "@id": "ct:argumentation-schemes"
   },
   "skos:definition": "The presumptive argument pattern \"if A is brought about, good (or bad) consequences will plausibly follow; so A should (or should not) be brought about\". It is a reasonable but defeasible basis for decisions about action, and it becomes the fallacy of appeal to consequences when it is used to settle what is true rather than what to do.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/critical-thinking-graph/id/scheme/argumentation"
   },
   "skos:prefLabel": "Argument from consequences",
