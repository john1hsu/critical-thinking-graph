   "cto:questionFor": {
    "@id": "ct:denying-a-conjunct"
   },
   "rdfs:label": "Could both conjuncts be false at the same time?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/denying-a-conjunct/cq/2",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:denying-a-conjunct"
   },
   "rdfs:label": "Has anyone actually established that at least one of the two options must hold, or is that an unstated assumption?"
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/denying-a-conjunct/cq/3",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:denying-a-conjunct"
   },
   "rdfs:label": "Does the denied conjunct, on its own, imply the conclusion regardless of the \"not both\" premise?"
  },
