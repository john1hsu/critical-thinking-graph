   "@type": "aif:I-node",
   "aif:claimText": "The 1-in-1,000 figure is the probability of a match if the employee did not enter, not the probability the employee did not enter given the match."
  },
  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/prosecutors-fallacy/map/p1",
