  {
   "@id": "https://github.com/john1hsu/critical-thinking-graph/id/conjunction-fallacy/cq/1",
   "@type": "cto:CriticalQuestion",
   "cto:questionFor": {
    "@id": "ct:conjunction-fallacy"
   },
   "rdfs:label": "Is the detailed version of the claim really more likely than the shorter claim it contains?"
